# Optional public endpoint URL. Never put API keys in VITE_ variables.
# The backend must allow the frontend origin via CORS when using another origin.
VITE_BRAILLE_API_URL=http://127.0.0.1:8000/api/braille/translate

# Optional development-only proxy target for the separate speech service.
SPEECH_BACKEND_URL=http://127.0.0.1:8001
